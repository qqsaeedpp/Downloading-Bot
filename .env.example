# =============================================================================
#  telegram-tools-bot — environment reference
# =============================================================================
#  Copy to `.env` and fill in. Every variable below is validated by Zod at
#  startup (packages/config); an invalid value fails the process immediately
#  rather than surfacing as a mystery at 3 a.m.
#
#  NEVER commit a filled-in .env. Cookie files and the bot token are secrets.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Pretty-printed logs for a terminal. Leave false in production (JSON to stdout).
LOG_PRETTY=true
APP_VERSION=1.0.0

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather. Treat as a password: it is never logged and never persisted.
TELEGRAM_BOT_TOKEN=

# An APPLICATION identity, from https://my.telegram.org → "API development
# tools". These are NOT the bot token above: the token identifies a bot to
# Telegram, api_id/api_hash identify the SOFTWARE talking to Telegram, and one
# cannot be derived from the other. Only the `telegram-bot-api` server uses
# them; the bot and worker never see them.
#
# `docker compose` reads them straight out of this file and refuses to run at
# all while either is empty — a missing value should stop a deploy rather than
# leave a container restarting forever. If you do not want a local Bot API
# server, delete the `telegram-bot-api` service from docker-compose.yml and set
# the public-API values noted below.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the bot sends its API calls. EMPTY means Telegram's public API; the
# value below is the `telegram-bot-api` service from docker-compose.yml, which
# is reachable only from inside the stack. See docs/deployment.md.
TELEGRAM_API_ROOT=http://telegram-bot-api:8081
# Set true only when TELEGRAM_API_ROOT points at a Bot API server you run.
# Its sole effect is to unlock the upload ceiling above 50: without it, startup
# refuses a larger value rather than letting every upload fail at runtime.
#
# TELEGRAM_USE_LOCAL_API is the older spelling of exactly this switch, still
# honoured so that upgrading does not mean editing a running deployment's .env.
# Set them to the SAME value: two different answers to one question are refused
# rather than silently resolved.
TELEGRAM_LOCAL_MODE=true
TELEGRAM_USE_LOCAL_API=true

# What Telegram will actually accept, in megabytes. 50 against the public API,
# up to 2000 against your own server.
#
# 1900 and not 2000 on purpose. The server's limit is measured on the ENCODED
# MULTIPART BODY, which is larger than the file inside it, so a ceiling set at
# exactly 2000 gets the upload rejected in its final moments — after the whole
# file has been streamed, which is the most expensive possible time to fail.
# The 100 MB of headroom pays for the encoding overhead.
#
# MAX_UPLOAD_MB (see "Size ceilings" below) is the older spelling; same rule,
# keep the two in step.
#
# Back to the public API? TELEGRAM_API_ROOT empty, both flags above false, and
# both ceilings 50.
TELEGRAM_UPLOAD_LIMIT_MB=1900

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_tools
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ── External binaries ────────────────────────────────────────────────────────
# Absolute paths inside the container. Leave as-is for the provided images.
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# The JavaScript runtime yt-dlp needs for YouTube.
#
# Since yt-dlp 2025.11.12 this is REQUIRED for full YouTube support: solving the
# player challenge (the `n` parameter that governs throttling, and the
# signature) runs JavaScript. Without it the format list for a YouTube video
# comes back empty or heavily reduced — which looks exactly like a post that has
# no media, and is why a long video could be offered as a still image.
#
# Deno is the only runtime yt-dlp enables by default; the images install it and
# pin it with the DENO_VERSION build arg. Every other platform is unaffected.
DENO_PATH=/usr/local/bin/deno

# ── Storage ──────────────────────────────────────────────────────────────────
# Root for per-job workspaces. Must be writable by the worker's non-root user.
DOWNLOAD_DIR=/data/downloads

# ── Size ceilings ────────────────────────────────────────────────────────────
# MAX_DOWNLOAD_MB — the hard ceiling on what yt-dlp may pull from the network.
#   Enforced twice: `--max-filesize` (only fires when the extractor declared a
#   size) and a runtime watchdog over the job workspace (covers HLS and every
#   other stream that declares nothing).
# MAX_UPLOAD_MB — the older spelling of TELEGRAM_UPLOAD_LIMIT_MB above; keep
#   the two identical. What Telegram will actually accept: 50 on the public
#   API, up to 1900 with a local Bot API server — 1900 and not the advertised
#   2000, because that limit is measured on the encoded multipart body, which
#   is larger than the file. Deliberately SEPARATE from the
#   download ceiling: a file may download fine and still be undeliverable — but
#   it may never EXCEED it, or the headroom could never be used and startup
#   says so.
# MAX_TRANSCODE_MB — above this, an incompatible codec (VP9/AV1/HEVC) is
#   delivered as a DOCUMENT rather than re-encoded. Not a remux: the original
#   file is sent untouched, at full quality, and simply will not play inline.
#   A 4K re-encode costs minutes of CPU per clip, which is longer than the
#   person waiting will give you.
MAX_DOWNLOAD_MB=2000
MAX_UPLOAD_MB=1900
MAX_TRANSCODE_MB=80
# Ship a file Telegram can already play as it is, instead of re-encoding it.
# Default on: a 4K AV1 clip takes longer to transcode than most people will
# wait for it, and arriving promptly is worth more than arriving perfect. Set
# false to always normalise to H.264/AAC first.
VIDEO_FAST_DELIVERY=true
# Refuse to start a job when the download volume has less than this free.
MIN_FREE_DISK_MB=2048

# ── Timeouts (milliseconds) ──────────────────────────────────────────────────
# JOB_TIMEOUT_MS must be at least the sum of DOWNLOAD + FFMPEG + UPLOAD, or the
# process refuses to start: a job would otherwise be killed before its slowest
# legal path could finish.
MEDIA_INSPECT_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=900000
FFMPEG_TIMEOUT_MS=900000
FFPROBE_TIMEOUT_MS=30000
TELEGRAM_UPLOAD_TIMEOUT_MS=900000
JOB_TIMEOUT_MS=3600000

# ── Worker / queue ───────────────────────────────────────────────────────────
DOWNLOAD_WORKER_CONCURRENCY=2
DOWNLOAD_JOB_ATTEMPTS=2
DOWNLOAD_JOB_BACKOFF_MS=5000
# Must exceed the longest single step the worker can take without renewing the
# lock. BullMQ renews at lockDuration/2 while the processor is alive.
DOWNLOAD_JOB_LOCK_DURATION_MS=60000
# How long a finished job's record is kept in Redis.
QUEUE_REMOVE_COMPLETE_AFTER_SECONDS=3600
QUEUE_REMOVE_FAIL_AFTER_SECONDS=604800
# Grace period the worker gives an in-flight job on SIGTERM before aborting it.
WORKER_SHUTDOWN_GRACE_MS=30000

# ── Progress reporting ───────────────────────────────────────────────────────
# A Telegram edit is rate-limited, so an update needs BOTH a minimum age and a
# meaningful change before it is worth spending.
PROGRESS_UPDATE_INTERVAL_MS=3000
PROGRESS_UPDATE_MIN_PERCENT=5

# ── Caching / retention ──────────────────────────────────────────────────────
MEDIA_INFO_CACHE_TTL_SECONDS=600
# How long a rendered quality menu stays actionable before its callbacks expire.
DOWNLOAD_SELECTION_TTL_SECONDS=1800
ORPHAN_WORKSPACE_MAX_AGE_HOURS=6
MAINTENANCE_INTERVAL_MS=900000

# ── Per-user limits ──────────────────────────────────────────────────────────
MAX_ACTIVE_JOBS_PER_USER=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
INSPECT_RATE_LIMIT_MAX=10

# ── FFmpeg normalisation ─────────────────────────────────────────────────────
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# ── Cookies (optional) ───────────────────────────────────────────────────────
# Netscape `cookies.txt` files, mounted read-only. See docs/security.md before
# using these: only ever supply cookies for an account YOU control and are
# permitted to use. Leave empty to run fully unauthenticated.
INSTAGRAM_COOKIES_PATH=
TIKTOK_COOKIES_PATH=
X_COOKIES_PATH=
PINTEREST_COOKIES_PATH=
# YouTube answers "Sign in to confirm you're not a bot" from some datacentre IP
# ranges. Unlike the other platforms, dropping cookies and retrying anonymously
# never helps — the check is answered BY an account. See the account-free
# alternatives below before reaching for this.
YOUTUBE_COOKIES_PATH=

# ── Extraction tuning (the account-free escape hatches) ──────────────────────
# One cookie file on the server serves EVERY user of the bot; nothing is stored
# per user and nobody has to log in. But a single account making thousands of
# requests can get that account rate-limited, so prefer these first.
#
# 1. A PO token provider. FREE, self-hosted, no account involved.
#
#    "Sign in to confirm you're not a bot" is a demand for a proof-of-origin
#    token: evidence that the request came from a real browser environment. The
#    `bgutil-provider` service in docker-compose.yml mints them locally, and the
#    matching yt-dlp plugin is already baked into the bot and worker images, so
#    setting this variable is the only step:
#      YOUTUBE_POT_PROVIDER_URL=http://bgutil-provider:4416
#
#    Try this BEFORE paying for a proxy. Note the upstream project's own wording
#    though: a PO token "may help your traffic seem more legitimate" but does not
#    guarantee a bypass. On a comprehensively flagged address it can still fail.
YOUTUBE_POT_PROVIDER_URL=
#
# 2. A proxy. YouTube's bot check is mostly about the address block, not the
#    visitor. A residential exit resolves it with no account at all — but it is
#    billed per gigabyte, and `--proxy` covers download traffic as well as
#    metadata, so every video a user requests is a real charge.
#      YTDLP_PROXY=socks5://user:pass@host:1080
YTDLP_PROXY=
#
# 3. Extractor arguments, per platform, WITHOUT the extractor prefix (the code
#    supplies it — X is `twitter` to yt-dlp). This is the escape hatch for a
#    platform changing its defences faster than any release cycle.
#
#    For YouTube, some player clients do not require a proof-of-origin token:
#      YOUTUBE_EXTRACTOR_ARGS=player_client=android_vr
#    or, with a PO-token provider sidecar such as bgutil-ytdlp-pot-provider:
#      YOUTUBE_EXTRACTOR_ARGS=player_client=default,web_safari
#
#    These change often. Check the current yt-dlp guidance before relying on a
#    specific value:
#      https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
INSTAGRAM_EXTRACTOR_ARGS=
TIKTOK_EXTRACTOR_ARGS=
X_EXTRACTOR_ARGS=
PINTEREST_EXTRACTOR_ARGS=
YOUTUBE_EXTRACTOR_ARGS=

# ── File tools ───────────────────────────────────────────────────────────────
# Eight operations on files the user sends: compress/resize/convert an image,
# pull an MP3 out of a video or strip its audio, build a PDF from images or
# render one back to images, and generate a QR code.
#
# OFF by default, and a downloader-only deployment should leave it off. Turning
# it on means a third container (apps/tools-worker), a second scratch volume,
# and FFmpeg + Poppler + libvips in the image. None of that earns its keep if
# nobody is going to resize a photo.
#
# docker-compose.yml sets this to true for the `tools-worker` service, which is
# not a contradiction: the schema answers "should a plain deployment pay for
# the tools", and the compose value answers "you have started the tools
# container". To run without them, do not start that service:
#   docker compose up -d postgres redis bot worker
#
# See docs/media-tools.md.
TOOLS_ENABLED=false

# Per-family switches. Turning one off stops its queue being drained; the jobs
# then WAIT in Redis rather than failing, and run when it is turned back on.
# The tools worker refuses to start only if all four are off, because then
# nothing would be drained at all.
IMAGE_TOOLS_ENABLED=true
VIDEO_TOOLS_ENABLED=true
PDF_TOOLS_ENABLED=true
QR_TOOLS_ENABLED=true

# How long a half-finished conversation survives — long enough to find and send
# a file, short enough that an abandoned draft does not hold one of the user's
# active slots until they notice.
TOOL_SESSION_TTL_SECONDS=900

# Root for per-job tool workspaces. Must differ from DOWNLOAD_DIR: the two have
# independent cleanup sweeps, so a shared directory means one process deleting
# the other's in-flight files. Startup refuses them being equal.
TOOL_WORKSPACE_DIR=/data/tools
TOOL_MIN_FREE_DISK_MB=2048
# The whole-job budget. Each family timeout below must fit inside it.
TOOL_JOB_TIMEOUT_MS=3600000
TOOL_UPLOAD_TIMEOUT_MS=900000

# ── Tool ceilings, per family ────────────────────────────────────────────────
# Split rather than shared because the resources differ by orders of magnitude:
# a 12000x12000 image and a two-hour video fail for completely different reasons
# and at completely different sizes.
#
# The three *_MAX_MB below are 20 and not 50 on purpose. They are INPUT limits,
# and the public Bot API refuses `getFile` above 20 MB whatever the upload
# ceiling says — so a larger value would promise to accept files the bot could
# never collect. Raise them only alongside a local Bot API server; startup
# checks them against what THIS deployment can actually fetch.
IMAGE_TOOL_MAX_MB=20
# Decompression-bomb guard: a few-kilobyte PNG can declare a canvas large enough
# to exhaust the host's memory once decoded.
IMAGE_TOOL_MAX_PIXELS=60000000
IMAGE_TOOL_MAX_DIMENSION=12000
IMAGE_TOOL_CONCURRENCY=3

VIDEO_TOOL_MAX_MB=20
VIDEO_TOOL_MAX_DURATION_SECONDS=7200
# One, deliberately: FFmpeg already saturates the cores it is given, so a second
# concurrent transcode makes both slower rather than the pair faster.
VIDEO_TOOL_CONCURRENCY=1
VIDEO_TOOL_TIMEOUT_MS=1800000

PDF_TOOL_MAX_MB=20
PDF_TOOL_MAX_PAGES=50
PDF_TOOL_MAX_IMAGES=50
# Raising this raises the pixel count of every rendered page. Startup refuses a
# DPI at which one A4 page would not fit under IMAGE_TOOL_MAX_PIXELS, because
# every rendered page would then be rejected after the render was paid for.
PDF_RENDER_DPI=150
PDF_TOOL_CONCURRENCY=1
PDF_TOOL_TIMEOUT_MS=900000

# A QR is milliseconds of work, so it gets the highest concurrency and the
# shortest timeout of the four. 7089 is the QR format's own byte ceiling, not a
# number chosen here; 1500 keeps the code scannable from a phone screen.
QR_MAX_INPUT_BYTES=1500
QR_TOOL_CONCURRENCY=4
QR_TOOL_TIMEOUT_MS=30000

# ── Tool queue and maintenance ───────────────────────────────────────────────
TOOL_QUEUE_JOB_ATTEMPTS=2
TOOL_QUEUE_BACKOFF_MS=5000
# Its own value rather than the downloader's: BullMQ renews the lock while the
# processor runs, so it belongs far BELOW the longest tool step, not above it. A
# lock that outlives the work stops a stalled job from ever being reclaimed.
TOOL_QUEUE_LOCK_DURATION_MS=60000
# These directories hold decoded video frames, so a container killed mid-render
# leaks gigabytes rather than kilobytes. Age-bounded, so a workspace belonging to
# a job still running on another replica is never removed out from under it.
TOOL_ORPHAN_WORKSPACE_MAX_AGE_HOURS=6
TOOL_MAINTENANCE_INTERVAL_MS=900000

MAX_ACTIVE_TOOL_JOBS_PER_USER=2
TOOL_PROGRESS_UPDATE_INTERVAL_MS=3000

# Where a LOCAL Bot API server keeps the files it downloads, as a
# comma-separated list of ABSOLUTE paths.
#
# Only the tools worker reads it, and only in local mode — the downloader
# uploads files and never fetches one, which is why this appears only here. In
# local mode `getFile` answers with a path on the SERVER's filesystem instead of
# a URL, and this list is what stops a misconfigured or compromised server from
# aiming that path at /etc.
#
# A list rather than one path because the Bot API server and this worker can
# mount the same volume at different places. Leave EMPTY to accept the default,
# /var/lib/telegram-bot-api, which is where docker-compose.yml mounts it — so a
# deployment that follows the compose file sets nothing here. Ignored entirely
# when local mode is off: every file then arrives over HTTPS.
TELEGRAM_LOCAL_FILE_ROOTS=

# ── Health endpoints ─────────────────────────────────────────────────────────
BOT_HEALTH_PORT=3001
WORKER_HEALTH_PORT=3002
TOOLS_WORKER_HEALTH_PORT=3003

# ── Privacy ──────────────────────────────────────────────────────────────────
# When false (default) only the origin + path shape of a source URL is stored;
# query strings — which can carry signed tokens or tracking identifiers — are
# dropped. Set true only if you need full URLs for debugging.
STORE_FULL_SOURCE_URL=false
