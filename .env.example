# =============================================================================
#  telegram-tools-bot — environment reference
# =============================================================================
#  Copy to `.env` and fill in. Every variable below is validated by Zod at
#  startup (packages/config); an invalid value fails the process immediately
#  rather than surfacing as a mystery at 3 a.m.
#
#  NEVER commit a filled-in .env. Cookie files and the bot token are secrets.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Pretty-printed logs for a terminal. Leave false in production (JSON to stdout).
LOG_PRETTY=true
APP_VERSION=1.0.0

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather. Treat as a password: it is never logged and never persisted.
TELEGRAM_BOT_TOKEN=

# Only set this when you run a local Bot API server (see docs/deployment.md).
# The public API caps uploads at 50 MB; a local server raises that to 2000 MB.
# Leave EMPTY to use Telegram's public API.
TELEGRAM_API_ROOT=
# Set true only when TELEGRAM_API_ROOT points at a Bot API server you run.
# Its sole effect is to unlock MAX_UPLOAD_MB above 50: without it, startup
# refuses a larger value rather than letting every upload fail at runtime.
TELEGRAM_USE_LOCAL_API=false

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_tools
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ── External binaries ────────────────────────────────────────────────────────
# Absolute paths inside the container. Leave as-is for the provided images.
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# The JavaScript runtime yt-dlp needs for YouTube.
#
# Since yt-dlp 2025.11.12 this is REQUIRED for full YouTube support: solving the
# player challenge (the `n` parameter that governs throttling, and the
# signature) runs JavaScript. Without it the format list for a YouTube video
# comes back empty or heavily reduced — which looks exactly like a post that has
# no media, and is why a long video could be offered as a still image.
#
# Deno is the only runtime yt-dlp enables by default; the images install it and
# pin it with the DENO_VERSION build arg. Every other platform is unaffected.
DENO_PATH=/usr/local/bin/deno

# ── Storage ──────────────────────────────────────────────────────────────────
# Root for per-job workspaces. Must be writable by the worker's non-root user.
DOWNLOAD_DIR=/data/downloads

# ── Size ceilings ────────────────────────────────────────────────────────────
# MAX_DOWNLOAD_MB — the hard ceiling on what yt-dlp may pull from the network.
#   Enforced twice: `--max-filesize` (only fires when the extractor declared a
#   size) and a runtime watchdog over the job workspace (covers HLS and every
#   other stream that declares nothing).
# MAX_UPLOAD_MB — what Telegram will actually accept. 50 on the public API,
#   up to 2000 with a local Bot API server. Deliberately SEPARATE from the
#   download ceiling: a file may download fine and still be undeliverable.
# MAX_TRANSCODE_MB — above this, an incompatible codec is remuxed and shipped
#   as-is instead of re-encoded. A 4K re-encode costs minutes of CPU per clip.
MAX_DOWNLOAD_MB=500
MAX_UPLOAD_MB=50
MAX_TRANSCODE_MB=250
# Refuse to start a job when the download volume has less than this free.
MIN_FREE_DISK_MB=2048

# ── Timeouts (milliseconds) ──────────────────────────────────────────────────
# JOB_TIMEOUT_MS must be at least the sum of DOWNLOAD + FFMPEG + UPLOAD, or the
# process refuses to start: a job would otherwise be killed before its slowest
# legal path could finish.
MEDIA_INSPECT_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=900000
FFMPEG_TIMEOUT_MS=900000
FFPROBE_TIMEOUT_MS=30000
TELEGRAM_UPLOAD_TIMEOUT_MS=900000
JOB_TIMEOUT_MS=3600000

# ── Worker / queue ───────────────────────────────────────────────────────────
DOWNLOAD_WORKER_CONCURRENCY=2
DOWNLOAD_JOB_ATTEMPTS=2
DOWNLOAD_JOB_BACKOFF_MS=5000
# Must exceed the longest single step the worker can take without renewing the
# lock. BullMQ renews at lockDuration/2 while the processor is alive.
DOWNLOAD_JOB_LOCK_DURATION_MS=60000
# How long a finished job's record is kept in Redis.
QUEUE_REMOVE_COMPLETE_AFTER_SECONDS=3600
QUEUE_REMOVE_FAIL_AFTER_SECONDS=604800
# Grace period the worker gives an in-flight job on SIGTERM before aborting it.
WORKER_SHUTDOWN_GRACE_MS=30000

# ── Progress reporting ───────────────────────────────────────────────────────
# A Telegram edit is rate-limited, so an update needs BOTH a minimum age and a
# meaningful change before it is worth spending.
PROGRESS_UPDATE_INTERVAL_MS=3000
PROGRESS_UPDATE_MIN_PERCENT=5

# ── Caching / retention ──────────────────────────────────────────────────────
MEDIA_INFO_CACHE_TTL_SECONDS=600
# How long a rendered quality menu stays actionable before its callbacks expire.
DOWNLOAD_SELECTION_TTL_SECONDS=1800
ORPHAN_WORKSPACE_MAX_AGE_HOURS=6
MAINTENANCE_INTERVAL_MS=900000

# ── Per-user limits ──────────────────────────────────────────────────────────
MAX_ACTIVE_JOBS_PER_USER=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
INSPECT_RATE_LIMIT_MAX=10

# ── FFmpeg normalisation ─────────────────────────────────────────────────────
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# ── Cookies (optional) ───────────────────────────────────────────────────────
# Netscape `cookies.txt` files, mounted read-only. See docs/security.md before
# using these: only ever supply cookies for an account YOU control and are
# permitted to use. Leave empty to run fully unauthenticated.
INSTAGRAM_COOKIES_PATH=
TIKTOK_COOKIES_PATH=
X_COOKIES_PATH=
PINTEREST_COOKIES_PATH=
# YouTube answers "Sign in to confirm you're not a bot" from some datacentre IP
# ranges. Unlike the other platforms, dropping cookies and retrying anonymously
# never helps — the check is answered BY an account. See the account-free
# alternatives below before reaching for this.
YOUTUBE_COOKIES_PATH=

# ── Extraction tuning (the account-free escape hatches) ──────────────────────
# One cookie file on the server serves EVERY user of the bot; nothing is stored
# per user and nobody has to log in. But a single account making thousands of
# requests can get that account rate-limited, so prefer these first.
#
# 1. A PO token provider. FREE, self-hosted, no account involved.
#
#    "Sign in to confirm you're not a bot" is a demand for a proof-of-origin
#    token: evidence that the request came from a real browser environment. The
#    `bgutil-provider` service in docker-compose.yml mints them locally, and the
#    matching yt-dlp plugin is already baked into the bot and worker images, so
#    setting this variable is the only step:
#      YOUTUBE_POT_PROVIDER_URL=http://bgutil-provider:4416
#
#    Try this BEFORE paying for a proxy. Note the upstream project's own wording
#    though: a PO token "may help your traffic seem more legitimate" but does not
#    guarantee a bypass. On a comprehensively flagged address it can still fail.
YOUTUBE_POT_PROVIDER_URL=
#
# 2. A proxy. YouTube's bot check is mostly about the address block, not the
#    visitor. A residential exit resolves it with no account at all — but it is
#    billed per gigabyte, and `--proxy` covers download traffic as well as
#    metadata, so every video a user requests is a real charge.
#      YTDLP_PROXY=socks5://user:pass@host:1080
YTDLP_PROXY=
#
# 3. Extractor arguments, per platform, WITHOUT the extractor prefix (the code
#    supplies it — X is `twitter` to yt-dlp). This is the escape hatch for a
#    platform changing its defences faster than any release cycle.
#
#    For YouTube, some player clients do not require a proof-of-origin token:
#      YOUTUBE_EXTRACTOR_ARGS=player_client=android_vr
#    or, with a PO-token provider sidecar such as bgutil-ytdlp-pot-provider:
#      YOUTUBE_EXTRACTOR_ARGS=player_client=default,web_safari
#
#    These change often. Check the current yt-dlp guidance before relying on a
#    specific value:
#      https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
INSTAGRAM_EXTRACTOR_ARGS=
TIKTOK_EXTRACTOR_ARGS=
X_EXTRACTOR_ARGS=
PINTEREST_EXTRACTOR_ARGS=
YOUTUBE_EXTRACTOR_ARGS=

# ── Health endpoints ─────────────────────────────────────────────────────────
BOT_HEALTH_PORT=3001
WORKER_HEALTH_PORT=3002

# ── Privacy ──────────────────────────────────────────────────────────────────
# When false (default) only the origin + path shape of a source URL is stored;
# query strings — which can carry signed tokens or tracking identifiers — are
# dropped. Set true only if you need full URLs for debugging.
STORE_FULL_SOURCE_URL=false
