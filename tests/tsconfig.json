{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "types": ["node", "vitest/globals"],
    "baseUrl": "..",
    // The suite runs straight from source, so the same aliases vitest.config.ts
    // installs at runtime have to exist at type-check time.
    "paths": {
      "@tgtools/shared": ["packages/shared/src/index.ts"],
      "@tgtools/config": ["packages/config/src/index.ts"],
      "@tgtools/logger": ["packages/logger/src/index.ts"],
      "@tgtools/database": ["packages/database/src/index.ts"],
      "@tgtools/queue": ["packages/queue/src/index.ts"],
      "@tgtools/telegram": ["packages/telegram/src/index.ts"],
      "@tgtools/downloader-engine": ["packages/downloader-engine/src/index.ts"],
      // Added late: without these two the tool packages' colocated tests
      // resolved through `node_modules` to `dist/*.d.ts`, so vitest ran against
      // `src` while tsc checked a build that could be hours old. A test written
      // against a signature that had just changed still type-checked.
      "@tgtools/tool-contracts": ["packages/tool-contracts/src/index.ts"],
      "@tgtools/file-tools-engine": ["packages/file-tools-engine/src/index.ts"],
      "@tgtools/feature-downloader": ["features/downloader/src/index.ts"],
      "@tgtools/feature-tools": ["features/tools/src/index.ts"],
      "@tgtools/feature-users": ["features/users/src/index.ts"],
      "@tgtools/feature-start": ["features/start/src/index.ts"],
      "@tgtools/feature-help": ["features/help/src/index.ts"]
    }
  },
  // Each package excludes `src/**/*.test.ts` from its own build so tests never
  // reach `dist`. That left the colocated suites type-checked by nothing at all
  // — a test calling a function with a missing required argument still compiled
  // and still passed, which is how a changed signature reached production
  // looking verified. They are checked here instead, where nothing is emitted.
  "include": ["**/*.ts", "../packages/*/src/**/*.test.ts", "../features/*/src/**/*.test.ts"]
}
