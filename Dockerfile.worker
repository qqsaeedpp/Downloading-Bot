# syntax=docker/dockerfile:1.7
# =============================================================================
#  Worker image — yt-dlp, FFmpeg, and everything expensive.
# =============================================================================

# yt-dlp changes weekly and an unpinned image means a rebuild can silently
# change extractor behaviour on a Friday afternoon. Pin it, and override at
# build time when you have deliberately tested a newer one:
#   docker compose build --build-arg YTDLP_VERSION=2026.08.01 worker
ARG YTDLP_VERSION=2026.07.04
ARG NODE_VERSION=22

# A JavaScript runtime is NOT optional for YouTube.
#
# Since yt-dlp 2025.11.12, solving YouTube's player challenge — the `n`
# parameter that governs throttling, and the signature — requires an external JS
# runtime. Without one, yt-dlp returns a severely reduced format list or none at
# all, which is indistinguishable from a post having no media. That is exactly
# how a 36-minute video ended up classified as a still image.
#
# Deno is the only runtime yt-dlp enables by default; the others are off for
# security reasons. The `yt-dlp-ejs` half is already bundled in the official
# `yt-dlp_linux` executable, so the runtime is all that is missing.
# Pinned for the same reason yt-dlp is: a silent runtime change must not be able
# to alter extraction behaviour between two builds of the same commit.
ARG DENO_VERSION=v2.9.4

# The proof-of-origin token provider plugin.
#
# "Sign in to confirm you're not a bot" is a demand for a PO token: an
# attestation that the request came from a real browser environment. This plugin
# fetches one from a provider service over HTTP, which lets a flagged address
# answer the challenge with no account and no paid residential exit.
#
# Baked in but INERT. yt-dlp only calls it when YOUTUBE_POT_PROVIDER_URL points
# at a running provider, so a deployment that does not want one is unaffected.
ARG POT_PLUGIN_VERSION=1.3.1

# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app

# Manifests only, so this layer survives every source change.
COPY package.json package-lock.json turbo.json ./
COPY apps/bot/package.json apps/bot/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/downloader-engine/package.json packages/downloader-engine/
COPY packages/logger/package.json packages/logger/
COPY packages/queue/package.json packages/queue/
COPY packages/shared/package.json packages/shared/
COPY packages/telegram/package.json packages/telegram/
COPY features/downloader/package.json features/downloader/
COPY features/help/package.json features/help/
COPY features/start/package.json features/start/
COPY features/users/package.json features/users/

# `--ignore-scripts` stops any dependency's postinstall from reaching the
# network to fetch its own binary — ours are installed deliberately, below.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

# ── Stage 2: compile ─────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY features/ features/
COPY apps/ apps/
RUN npx turbo run build --filter=@tgtools/worker

# Drop dev dependencies from the tree that ships.
RUN --mount=type=cache,target=/root/.npm \
    npm prune --omit=dev

# ── Stage 3: runtime ─────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ARG YTDLP_VERSION
ARG DENO_VERSION

ENV NODE_ENV=production \
    YTDLP_PATH=/usr/local/bin/yt-dlp \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    DENO_PATH=/usr/local/bin/deno \
    DOWNLOAD_DIR=/data/downloads

# `tini` as PID 1 so SIGTERM reaches Node and the graceful shutdown actually
# runs — without an init, a killed yt-dlp child becomes a zombie and the
# container accumulates them until it runs out of process slots.
# `unzip` is only needed by the Deno installer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        python3 \
        tini \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# The single-file build, pinned by tag. Verified by running it once at build
# time: a truncated download would otherwise only be discovered by the first
# user whose link needed it.
RUN curl -fsSL --retry 3 \
        "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
        -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && /usr/local/bin/yt-dlp --version

# The JavaScript runtime yt-dlp needs for YouTube's player challenge. The
# official installer picks the right architecture; `DENO_INSTALL` puts the
# binary on the default PATH, where yt-dlp looks for it without configuration.
RUN curl -fsSL https://deno.land/install.sh \
        | DENO_INSTALL=/usr/local sh -s "${DENO_VERSION}" \
    && /usr/local/bin/deno --version

# yt-dlp discovers plugins under /etc/yt-dlp/plugins, and the release zip already
# carries the `yt_dlp_plugins/` tree its loader expects. Asserting that directory
# exists catches a redirect to an HTML error page, which unzips "successfully"
# into something yt-dlp would silently ignore.
ARG POT_PLUGIN_VERSION
RUN curl -fsSL --retry 3 \
        "https://github.com/Brainicism/bgutil-ytdlp-pot-provider/releases/download/${POT_PLUGIN_VERSION}/bgutil-ytdlp-pot-provider.zip" \
        -o /tmp/pot-plugin.zip \
    && mkdir -p /etc/yt-dlp/plugins \
    && unzip -q /tmp/pot-plugin.zip -d /etc/yt-dlp/plugins/bgutil \
    && rm /tmp/pot-plugin.zip \
    && test -d /etc/yt-dlp/plugins/bgutil/yt_dlp_plugins

WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages ./packages
COPY --from=build /app/features ./features
COPY --from=build /app/apps/worker ./apps/worker
COPY --from=build /app/apps/bot/package.json ./apps/bot/package.json
COPY infra/migrations ./infra/migrations

# Non-root. The download volume is the only thing this process may write to.
RUN groupadd --system --gid 1001 tgtools \
    && useradd --system --uid 1001 --gid tgtools --no-create-home tgtools \
    && mkdir -p /data/downloads \
    && chown -R tgtools:tgtools /data
USER tgtools

EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_HEALTH_PORT||3002)+'/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/worker/dist/bootstrap.js"]
